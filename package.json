{
  "name": "chainsaw-aliens",
  "private": true,
  "version": "0.0.0",
  "description": "Static Chainsaw Aliens game with optional dev test harness",
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "jszip": "^3.10.1",
    "soundfont-player": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "playwright": "^1.46.0"
  },
  "scripts": {
    "prepare:playwright": "npx playwright install --with-deps chromium",
    "prepare:playwright:deps": "npx playwright install --with-deps chromium",
    "test:dashboard": "npm run prepare:playwright && node tools/test-runner/run.cjs",
    "test:robtersession-songs": "node tools/robtersession/song-generator-harness.js",
    "test:robtersession-midi": "node tools/robtersession-midi-tests.cjs",
    "test:race-physics-feel": "node --test tests/unit/racePhysicsFeel.test.js",
    "test:vehicle-dynamics:smoke": "node tools/run-vehicle-dynamics-tests.mjs smoke",
    "test:vehicle-dynamics:full": "FULL_PHYSICS_MATRIX=1 node tools/run-vehicle-dynamics-tests.mjs full",
    "test:vehicle-validation:smoke": "node --test --test-concurrency=1 --test-name-pattern='exact WRX validation smoke' tests/unit/vehicleValidationHarness.test.js",
    "test:vehicle-validation:wrx": "node tools/vehicle-validation/run-validation.mjs --vehicle=wrx-manual,wrx-automatic --case=all --aids=both --report=artifacts/vehicle-validation/wrx.json",
    "test:vehicle-validation:brz": "node tools/vehicle-validation/run-validation.mjs --vehicle=brz-manual --case=all --aids=both --report=artifacts/vehicle-validation/brz.json",
    "test:vehicle-validation:civic": "node tools/vehicle-validation/run-validation.mjs --vehicle=civic-type-r-manual --case=all --aids=both --report=artifacts/vehicle-validation/civic-type-r.json",
    "test:vehicle-validation:high-energy": "node --test --test-concurrency=1 --test-name-pattern='high-energy runtime fixture uses exact 300 mph|300 mph (head-on|45-degree|broadside|reverse|spinning-impact) thin-wall collision|dense probe faces reduce|wall manifold bounds|wall floor corner terminates' tests/unit/highEnergyCollisionRuntime.test.js tests/unit/persistentCollisionManifold.test.js",
    "test:vehicle-validation:collision-risks": "node --test --test-concurrency=1 tests/unit/physicsTerrainQueryFrame.test.js tests/unit/chassisBodyCollision.test.js tests/unit/persistentCollisionManifold.test.js",
    "test:vehicle-validation:replay": "node --test --test-concurrency=1 tests/unit/vehicleDynamicsReplay.test.js tests/unit/studioSprint2PhysicsIncident.test.js",
    "test:studio-sprint2-hill-acceptance": "node --test tests/unit/studioSprint2PhysicsIncident.test.js",
    "test:studio-sprint2-physics-performance": "node tools/run-studio-sprint2-physics-performance.mjs",
    "test:race-physics-feel:browser": "playwright test tests/playwright/race-physics-feel.spec.js",
    "test:playwright": "playwright test tests/playwright",
    "test:playwright:headed": "playwright test --headed"
  },
  "type": "module"
}
